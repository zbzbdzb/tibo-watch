{
  "manifest_version": 3,
  "name": "Tibo Watch Chrome Companion",
  "description": "Uses the current Chrome X session to send visible @thsottiaux posts to the local Tibo Watch app.",
  "version": "0.2.13",
  "key": "",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "http://127.0.0.1:47652/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tibo Watch Chrome Companion"
  }
}
