{
  "name": "tibo-watch",
  "version": "0.1.1",
  "private": true,
  "description": "Windows desktop monitor for Tibo's Codex reset announcements",
  "main": "dist/main/main.js",
  "author": "Tibo Watch",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n renderer,main,electron -c blue,green,magenta \"pnpm:dev:renderer\" \"pnpm:dev:main\" \"pnpm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run",
    "test:watch": "cross-env NODE_NO_WARNINGS=1 vitest",
    "test:e2e": "playwright test",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "fast-xml-parser": "5.10.1",
    "lucide-react": "1.28.0",
    "nodemailer": "9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "smtp-server": "3.19.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.tibowatch.desktop",
    "productName": "Tibo Watch",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tibo-Watch-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
